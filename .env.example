# cp .env.example .env then fill values (never commit .env)
HELIUS_API_KEY=
GMGN_API_KEY=
# Optional tuning
HUNTER_CYCLE_MIN=
HARVEST_TOKENS_PER_CYCLE=
STATS_CALLS_PER_CYCLE=
GMGN_MAX_PER_MIN=
GMGN_MIN_GAP_SEC=
# Wallet backup repo (optional; sync runs after each daemon cycle when set)
# SSH deploy key: git@github.com:nodepedia/lowcap-wallets.git
# HTTPS token:    https://github.com/nodepedia/lowcap-wallets.git + WALLETS_REPO_TOKEN
WALLETS_REPO_URL=https://github.com/nodepedia/lowcap-wallets.git
# Isi fine-grained PAT (Contents read/write ke lowcap-wallets), lalu jalankan bot:
WALLETS_REPO_TOKEN=
# Token: classic PAT (repo) or fine-grained with Contents read+write on lowcap-wallets. No quotes/spaces.
# .env is loaded from the lowcap-hunter folder (any cwd). If git fails, sync falls back to the GitHub Contents API.
WALLETS_REPO_DIR=~/lowcap-wallets
